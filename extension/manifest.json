{
  "manifest_version": 3,
  "name": "CodeRevise",
  "version": "1.0.0",
  "description": "Sync your solved LeetCode problems with CodeRevise.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode-revision-xnpg.onrender.com/*",
    "https://leet-code-revision.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leet-code-revision.vercel.app/*"
      ],
      "js": [
        "auth-handler.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
